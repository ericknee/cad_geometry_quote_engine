# Copy to .env and fill in. Loaded by backend/api/config.py and docker-compose.yml.
# .env is git-ignored; never commit real credentials.

# MongoDB connection. Host dev: localhost (compose publishes the port). Inside compose the api
# service overrides this to mongodb://mongo:27017.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=vendra
MONGO_PORT=27017

# Where uploaded STEP files are stored (outside any web root).
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=50

# Optional: "prod" turns off /docs, /redoc and /openapi.json. Defaults to "dev".
ENVIRONMENT=dev
